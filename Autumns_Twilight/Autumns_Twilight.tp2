SAY SELECT_COMMON2 @700018 /* ¿Sí? */
SAY SELECT_COMMON3 @700019 /* Estoy esperando. */
SAY SELECT_COMMON4 @700020 /* Espero que tu voluntad sea clara. */
SAY SELECT_COMMON5 @700021 /* ¿Qué es lo que quieres? */
SAY SELECT_COMMON6 @700022 /* Siempre sé vigilante. */
SAY SELECT_ACTION1 @700023 /* Hm.  */
