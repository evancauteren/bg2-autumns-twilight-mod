SAY DAMAGE ~~ [p_alen14]
SAY DYING @700039 /* Finalmente... la muerte... se apodera de mí... */
SAY HURT @700011 /* Mi magia no puede protegerme de esto. ¡Necesito asistencia! */
SAY AREA_FOREST @700012 /* Aún los bosques son capaces de soportar el invierno. Los humanos tienen mucho que aprender de ellos. */ 
SAY AREA_CITY @700013 /* Pensarías que detesto las ciudades. Sin embargo, algunos nobles tienen buen gusto en la arquitectura. */
SAY AREA_DUNGEON @700014 /* Con todo el poder que ostentas, ¿no eres capaz de contratar a algunos humanos para que hagan este trabajo? */
SAY AREA_DAY @700015 /* Los días buenos son días grises. */
SAY AREA_NIGHT @700016 /* La noche pertenece al invierno... */
SAY SELECT_COMMON1 @700017 /* Invierno eterno. */
SAY SELECT_COMMON2 @700018 /* ¿Sí? */
SAY SELECT_COMMON3 @700019 /* Estoy esperando. */
SAY SELECT_COMMON4 @700020 /* Espero que tu voluntad sea clara. */
SAY SELECT_COMMON5 @700021 /* ¿Qué es lo que quieres? */
SAY SELECT_COMMON6 @700022 /* Siempre sé vigilante. */
SAY SELECT_ACTION1 @700023 /* Hm.  */
SAY SELECT_ACTION2 @700024 /* Soy el Maestro de la Escarcha... esta tarea no es digna de mí. */
SAY SELECT_ACTION3 @700025 /* Sé respetuoso... o de lo contrario congelaré tu corazón. */
SAY SELECT_ACTION4 @700026 /* El conocimiento es lo más importante. La fuerza bruta es intracendente. */
SAY SELECT_ACTION5 @700027 /* Estoy convencido de que interactuar con un gólem es más interesante que esto. */
SAY SELECT_ACTION6 @700028 /* Estoy sobrecalificado para esto. */
SAY SELECT_ACTION7 @700029 /* Lo haré y quedarás conforme. */
SAY SELECT_RARE1 @700030 /* Asumo que responder ante ti es mejor que responder ante Cryonax. */
SAY SELECT_RARE2 @700031 /* Debo admitirlo: eres un mejor aliado que Icelock. */
SAY CRITICAL_HIT @700032 /* ¡Evereska! */
SAY CRITICAL_MISS @700033 /* Esta no es mi principal habilidad. */
SAY TARGET_IMMUNE @700034 /* Mejor piensa en otra solución, joven. */
SAY INVENTORY_FULL @700035 /* Me debes haber confundido con una mula de carga. Tus cosas ahora yacen en el suelo. */ 
SAY SPELL_DISRUPTED @700036 /* ¡Hmpf! Han interrumpido mi sortilegio. */
//SAY REACT_TO_DIE_GENERAL @700037 /* Tu muerte no será en vano. */
SAY PICKED_POCKET @700040 /* I'm not proud of it, but I got away with it. */
SAY HIDDEN_IN_SHADOWS @700040 /* Like a shadow, I disappear. */
SAY SET_A_TRAP @700040 /* Ha! Let's see them try and get past that now. */
SAY BIO @700038 /* Cuando preguntas por su pasado, ALENDIR cuenta con orgullo que proviene de una noble línea de descendencia de Altos Elfos de Cormanthyr y (siempre que puede) te recuerda lo afortunado que eres de que te esté acompañando en tus insulsas aventuras. No habla mucho más de sus experiencias personales, excepto de lo peligroso que fue entrenarse como Maestro de la Escarcha en el Reino Oculto. Si bien Alendir es anciano, bien sabes que los elfos rara vez demuestran facciones de decrepitud. No fue el caso de Alendir, ya que su entrenamiento en el Frío de Cryonax le costó su energía vital, a cambio de obtener un poder absoluto en el Plano Paraelemental del Hielo. Luego de su muerte a manos de Icelock, el mismo fue revivido por Vidomina, una poderosa hechicera de Falcongrís. Alendir tiene ahora otra oportunidad de redimir sus ambiciosos actos arcanos a tu lado.  */
WRITE_ASCII 0x248 ~P_Ale25S~ #8  // OVERRIDE SCRIPT - Scripts acerca de los comandos, banthers, etc (coincide con el nombre del archivo BAF)
WRITE_ASCII 0x2cc ~P_Alen25~  #8  // DIALOGUE FILE - Archivo de saludo de Fall
WRITE_ASCII 0x280 ~P_Alen~  #32 // DEATH VARIABLE - Hace referencia a c?mo nos referimos a Fall en el juego. (Ej.: In Party (P_Fall))
WRITE_ASCII 0x34  ~P_ALEN~ #8  // small portrait
WRITE_ASCII 0x3c  ~P_ALENL~ #8  // medium portrait
WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~P_FMAS~))


