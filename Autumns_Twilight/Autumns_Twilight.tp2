SAY NAME1 @200018 /* Alendir */
SAY NAME2 @200018 /* Alendir */
SAY INITIAL_MEETING @700000 /* ¿He vuelto... a la vida? */ 
SAY MORALE @700040 /* ... */
SAY HAPPY @700001 /* Pareces ser más competente de lo que aparentas. */ 
SAY UNHAPPY_ANNOYED @700002 /* Siempre me pareciste un insensato... ahora me lo acabas de confirmar con tus tontos actos. */ 
SAY UNHAPPY_SERIOUS @700040 /* ... */
SAY UNHAPPY_BREAKING @700040 /* ... */
SAY LEADER @700003 /* Una elección acorde a lo que buscas. Soy viejo y longevo y con mi sabiduría e inteligencia llegaremos lejos, os lo puedo asegurar. */
SAY TIRED @700004 /* Mis fuerzas flaquean como el hielo bajo el sol. Necesito descanso. */
SAY BORED @700005 /* Nos tienes paralizados como si estuviésemos en Frostfell. ¡Es hora de moverse! */
SAY BATTLE_CRY1 @700006 /* ¡Siente el poder del Hielo! */
SAY BATTLE_CRY2 @700007 /* ¡Sed testigos de mi poder! */
SAY BATTLE_CRY3 @700008 /* El invierno no tiene piedad. */
SAY BATTLE_CRY4 @700009 /* Represento el poder de Cormanthyr. */
