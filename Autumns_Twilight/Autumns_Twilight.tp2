PRINT ~Installing Dusk, The Wizardslayer~
COPY ~Autumns_Twilight/Characters/cre_and_portraits/P_Dusk.cre~ ~override/P_Dusk.cre~
SAY NAME1 @4002 /* Dusk */
SAY NAME2 @4002 /* Dusk */
SAY INITIAL_MEETING @4003 /* Mis o�dos a�n retumban con esa explosi�n... */ 
SAY MORALE @4004 /* �No...!,���NO!!! */
SAY HAPPY @4005 /* Me gusta c�mo este grupo maneja las cosas. */ 
SAY UNHAPPY_ANNOYED @4006 /* Deber�amos reconsiderar nuestras acciones... */ 
SAY UNHAPPY_SERIOUS @4007 /* Claramente algo no funciona aqu�... */
SAY UNHAPPY_BREAKING @4008 /* No podemos seguir trabajando juntos... */
SAY LEADER @4009 /* Te prefiero a ti como l�der, pero si insistes... */
SAY TIRED @40010 /* *bostezo* Creo que necesitamos descansar, �no lo crees? */
SAY BORED @40011 /* No importa lo lento que vayas mientras no te detengas... */
SAY BATTLE_CRY1 @40012 /* ¡Luchen con determinación, pues este es nuestro deber! */
SAY BATTLE_CRY2 @40013 /* ¡Por Cormyr! */
SAY BATTLE_CRY3 @40014 /* ¡Siente la ira de la Primera Espada! */
SAY BATTLE_CRY4 @40044 /* ¡Enfrenten al enemigo con todas sus fuerzas! */
SAY BATTLE_CRY5 @40049 /* ¡Prepárense; la batalla está sobre nosotros! */
SAY DAMAGE ~~ [P_Dusk19]
SAY DYING ~~ [P_Dusk20]
SAY HURT @40015 /* Lo lamento... necesito a alguien que se ocupe de mis heridas. */
SAY AREA_FOREST @40016 /* Debemos cuidarnos de las bestias salvajes. Por m�s hermoso que sea el bosque, el peligro se encuentra a la vuelta de la esquina... */  // If there's no sound file for the line, then it's going to be silent.
SAY AREA_CITY @40017 /* Es incre�ble c�mo la corrupci�n ha invadido hasta el rinc�n m�s rec�ndito de la ciudad... */
SAY AREA_DUNGEON @40018 /* Debes tener cuidado aqu�. Presiento... peligro. */
SAY AREA_DAY @40019 /* Hoy es un buen d�a para pasear. Pero recuerda, <CHARNAME>, que tenemos un deber que cumplir. */
SAY AREA_NIGHT @40020 /* Las estrellas brillan en el firmamento, pero �cuidado! No todo lo que brilla es oro... All that is gold does not glitter*/
SAY SELECT_COMMON1 @40021 /* Capitán Ardusk Aldant a tu servicio. */
SAY SELECT_COMMON2 @40022 /* ¿Qué tienes en mente? */
SAY SELECT_COMMON3 @40023 /* Esperando órdenes. */
SAY SELECT_COMMON4 @40039 /* Hola extraño. */
SAY SELECT_COMMON5 @40040 /* Te protegeré. */
SAY SELECT_COMMON6 @40046 /* Recuerda: nadie te golpeará tan fuerte como la vida misma. */
SAY SELECT_ACTION1 @40024 /* �Muy bien! */
SAY SELECT_ACTION2 @40025 /* S�, s�. No necesitas gritar. */
SAY SELECT_ACTION3 @40026 /* Hmmm... s�, �por qu� no? */
SAY SELECT_ACTION4 @40027 /* Te seguir�. */
SAY SELECT_ACTION5 @40028 /* Una vez m�s... */
SAY SELECT_ACTION6 @40029 /* D�jamelo a m�. */
SAY SELECT_ACTION7 @40030 /* Puedo soportarlo. */
SAY SELECT_RARE1 @40031 /* Hmm... �te conozco? �Ja! S�lo bromeo. */
SAY SELECT_RARE2 @40032 /* Agradezco la atenci�n, pero �no deber�amos centrarnos en el asunto que nos ocupa? */
SAY CRITICAL_HIT @40047 /* ¡¡¡Un golpe perfecto!!! */
SAY CRITICAL_MISS @40034 /* La culpa es mía. ¡Debo mejorar mis habilidades! */
SAY TARGET_IMMUNE @40048 /* *suspiro* Mi objetivo es inmune... */
SAY INVENTORY_FULL @40036 /* Lo siento, pero mi mochila est� llena. */ 
SAY SPELL_DISRUPTED @40037 /* Oh, �maldici�n! */
SAY REACT_TO_DIE_GENERAL @40045 /*  */ // Reacci�n a la muerte de un compa�ero de grupo
SAY PICKED_POCKET @40051 /* Vaya... le he robado... */
SAY HIDDEN_IN_SHADOWS @40041 /* Shhh... ahora estoy en las sombras... */
SAY SET_A_TRAP @40050 /* *risa* La trampa... ha sido puesta. */
SAY BIO @40038 /* Cuando preguntas por su pasado, DUSK queda un instante pensativo. Dice que sus frecuentes visitas al Paseo de Waukin se deben a un extra�o deseo por convertirse en mercader. Lo cierto es que Dusk, en su vida pasada, fue Primera Espada del ej�rcito de los Dragones P�rpuras de Cormyr. Su viaje al sur, como mensajero de la paz, se vio frustrado por una serie de sucesos que dice narrar� a su debido momento. Por lo pronto, dice provenir de los Aldant, una familia noble del norte que, anta�o, combati� contra liches y nigromantes de Netheril, incluyendo al peligroso Aumvor. Dusk dice no estar seguro de la veracidad de ciertas narraciones que le contaron cuando era s�lo un ni�o, pero lo cierto es que siente una especial aversi�n hacia los liches. */
WRITE_ASCII 0x248 ~P_DuskS~ #8  // OVERRIDE SCRIPT - Di�logos acerca de los comandos, banthers, etc (coincide con el nombre del archivo BAF)
WRITE_ASCII 0x2cc ~P_Dusk~  #8  // DIALOGUE FILE - Archivo de saludo de Dusk
WRITE_ASCII 0x280 ~P_Dusk~  #32 // DEATH VARIABLE - Hace referencia a c�mo nos referimos a Dusk en el juego. (Ej.: In Party (P_Dusk))
WRITE_ASCII 0x34  ~DuskS~ #8  // small portrait
WRITE_ASCII 0x3c  ~DuskM~ #8  // medium portrait
////////////////

PRINT ~Installing Fall, The Lady of the Beasts~
COPY ~Autumns_Twilight/Characters/cre_and_portraits/P_Fall.cre~ ~override/P_Fall.cre~ 

SAY NAME1 @2 /* Fall */
SAY NAME2 @2 /* Fall */
SAY INITIAL_MEETING @3 /* ... */ 
SAY MORALE @4 /* Time to make like a tree and leaf! */
SAY HAPPY @5 /* I'm really proud of us. */ 
SAY UNHAPPY_ANNOYED @6 /* You're making us look bad. */ 
SAY UNHAPPY_SERIOUS @7 /* We need to get back on track. */
SAY UNHAPPY_BREAKING @8 /* I'm done with this. I'm leaving. */
SAY LEADER @9 /* Let's do this together. */
SAY TIRED @10 /* I need to catch my breath. */
SAY BORED @11 /* I hope something happens soon. */
SAY BATTLE_CRY1 @12 /* Let's see what you've got! */
SAY BATTLE_CRY2 @13 /* For Imnescar! */
SAY BATTLE_CRY3 @14 /* You're no match for me! */
SAY BATTLE_CRY4 @15 /* You're outmatched and outclassed! */
SAY BATTLE_CRY5 @16 /* I'll leave you begging for mercy! */
SAY DAMAGE ~~ [p_fall26]
SAY DYING ~~ [p_fall25]
SAY HURT @17 /* Can someone please tend to my wounds? */
SAY AREA_FOREST @18 /* I feel so alive and free when I'm wandering through the woods. */ 
SAY AREA_CITY @19 /* It's like everyone here is in a rush to get somewhere, but they don't even know where they're going. */
SAY AREA_DUNGEON @20 /* I've tracked dangerous creatures through places like this before. We need to be ready for anything. */
SAY AREA_DAY @21 /* This weather puts me in such a good mood. I can't help but smile. */
SAY AREA_NIGHT @22 /* The night is full of secrets and mysteries, waiting to be discovered. */
SAY SELECT_COMMON1 @23 /* I'm the Lady of the Beasts: swift and stealthy. */
SAY SELECT_COMMON2 @24 /* The howl of the wolves is a call to battle! */
SAY SELECT_COMMON3 @25 /* My bolts will find their mark. */
SAY SELECT_COMMON4 @26 /* I'm quick on my feet and even quicker with my crossbow. */
SAY SELECT_COMMON5 @27 /* The wolves are with us! */
SAY SELECT_COMMON6 @28 /* I'm not afraid of anything. */
SAY SELECT_ACTION1 @29 /* We'll find what we're looking for. */
SAY SELECT_ACTION2 @30 /* I'll cover our tracks. */
SAY SELECT_ACTION3 @31 /* The pack is always by my side. */
SAY SELECT_ACTION4 @32 /* With each shot, I honor my father's legacy. */
SAY SELECT_ACTION5 @33 /* I won't disappoint you. */
SAY SELECT_ACTION6 @34 /* With the grace of the forest, I will succeed. */
SAY SELECT_ACTION7 @35 /* My father always said, 'Aim true and strike hard.' */
SAY SELECT_RARE1 @36 /* Back home, we had a saying: 'a day without fruit is a day without sunshine'. */
SAY SELECT_RARE2 @37 /* Growing up, my family had the most bountiful grapevines in all the land. */
SAY CRITICAL_HIT @38 /* Right on target! */
SAY CRITICAL_MISS @39 /* Ups! I hope nobody saw that! */
SAY TARGET_IMMUNE @40 /* This one is going to be tough, it's immune! */
SAY INVENTORY_FULL @41 /* Sorry! My backpack if full! */ 
SAY SPELL_DISRUPTED @42 /* Argh, not now! I was about to cast the perfect spell! */
SAY REACT_TO_DIE_GENERAL @43 /* Whatever it takes, I'll make sure your death is not in vain. */
SAY PICKED_POCKET @44 /* I'm not proud of it, but I got away with it. */
SAY HIDDEN_IN_SHADOWS @45 /* Like a shadow, I disappear. */
SAY SET_A_TRAP @46 /* Ha! Let's see them try and get past that now. */
SAY BIO @47 /* Cuando preguntas por su pasado, FALL se queda un instante pensativa mientras juega con las rojas mangas de su túnica. Ella cuenta con orgullo que proviene de la pequeña Inmescar, otrora paraje donde tuvo lugar el combate contra los ogros que evitaban el comercio agrícola entre Crimmor y Murann. Antes de que comience a darte una historia sobre el cultivo de frutas, la interrumpes y preguntas por su familia, lo que provoca un repentino silencio, dando como respuesta que te hablará de ello más adelante si así lo quisieras.  */
WRITE_ASCII 0x248 ~P_FallS~ #8  // OVERRIDE SCRIPT - Scripts acerca de los comandos, banthers, etc (coincide con el nombre del archivo BAF)
WRITE_ASCII 0x2cc ~P_Fall~  #8  // DIALOGUE FILE - Archivo de saludo de Fall
WRITE_ASCII 0x280 ~P_Fall~  #32 // DEATH VARIABLE - Hace referencia a c�mo nos referimos a Fall en el juego. (Ej.: In Party (P_Fall))
WRITE_ASCII 0x34  ~P_FallS~ #8  // small portrait
WRITE_ASCII 0x3c  ~P_FallM~ #8  // medium portrait
//PRINT ~Fall in Game~


COPY ~Autumns_Twilight/Characters/cre_and_portraits/P_Chon.cre~ ~override/P_Chon.cre~ 

SAY NAME1 @200175 /* Cho'Nuja */
SAY NAME2 @200175 /* Cho'Nuja */
SAY INITIAL_MEETING @600000 /* Nos encontramos de nuevo, soldado. */ 
SAY MORALE @600040 /* Time to make like a tree and leaf! */
SAY HAPPY @600001 /* Fue una buena decisión seguirte fuera del Abismo. */ 
SAY UNHAPPY_ANNOYED @600002 /* Nunca entenderé a los habitantes de la superficie. */ 
SAY UNHAPPY_SERIOUS @600040 /* We need to get back on track. */
SAY UNHAPPY_BREAKING @600040 /* I'm done with this. I'm leaving. */
SAY LEADER @600003 /* ¿Quieres mi experiencia como comandante? Bien, lo haré. */
SAY TIRED @600004 /* Ni siquiera yo exigía tanto a mis soldados. */
SAY BORED @600005 /* ¡Soldado! Ya es tiempo de dejar de holgazanear. */
SAY BATTLE_CRY1 @600006 /* ¡Por Dreach-naga! */
SAY BATTLE_CRY2 @600007 /* ¡Siente la furia de mis garras! */
SAY BATTLE_CRY3 @600008 /* ¡Tu extinción está cerca! */
SAY BATTLE_CRY4 @600009 /* No le temas a la muerte. ¡Témeme a mí! */
SAY BATTLE_CRY5 @600010  /* ¡Eres un insensato por enfrentarte a nosotros! */
SAY DAMAGE ~~ [p_chon14]
SAY DYING ~~ [p_chon15]
SAY HURT @600011 /* Necesito tu ayuda, mi amigo. Mi regeneración no está funcionando lo suficientemente rápido. */
SAY AREA_FOREST @600012 /* No existe tanta diferencia entre este terreno al de mi pantano. Bueno, puede que aquí haya menos hydras. */ 
SAY AREA_CITY @600013 /* Si alguien pregunta por mí, díles que soy una convocación. Eso funcionará, ¿sí? */
SAY AREA_DUNGEON @600014 /* He nacido para combatir en sitios como éste. Confía en mi fuerza, mi amigo. */
SAY AREA_DAY @600015 /* No sé si algún día pueda acostumbrarme a este clima. Aunque debo decir que los rayos del sol me calman. */
SAY AREA_NIGHT @600016 /* Ahora, este ambiente es más similar a mi querida Dreach-naga. */
SAY SELECT_COMMON1 @600017 /* General Cho'Nuja a tu servicio. */
SAY SELECT_COMMON2 @600018 /* Mis garras, tus armas. */
SAY SELECT_COMMON3 @600019 /* Gloria Regalis */
SAY SELECT_COMMON4 @600020 /* Este es el tiempo de no arrepentirse. */
SAY SELECT_COMMON5 @600021 /* Vivo de nuevo por ti.  */
SAY SELECT_COMMON6 @600022 /*  Profeso la antigua fe de la guerra y el coraje. */
SAY SELECT_ACTION1 @600023 /* Sin miedo.  */
SAY SELECT_ACTION2 @600024 /* La vida recién comienza. */
SAY SELECT_ACTION3 @600025 /* Somos verdaderos sobrevivientes. */
SAY SELECT_ACTION4 @600026 /* Un verdadero líder sabe cuándo seguir órdenes. */
SAY SELECT_ACTION5 @600027 /* Esta tierra es incierta para mí. */
SAY SELECT_ACTION6 @600028 /* Honor y muerte. */
SAY SELECT_ACTION7 @600029 /* Mi reino no es de este mundo. */
SAY SELECT_RARE1 @600030 /* Dreach-naga siempre vivirá en mi corazón. */
SAY SELECT_RARE2 @600031 /* Nuestros actos prosiguen su camino. */
SAY CRITICAL_HIT @600032 /* ¡Siente la furia del Pantano! */
SAY CRITICAL_MISS @600033 /* ¡Por el aliento de Rask'tar! */
SAY TARGET_IMMUNE @600034 /* Esta criatura es inmune. */
SAY INVENTORY_FULL @600035 /* No puedo llevar más nada, soldado. */ 
SAY SPELL_DISRUPTED @600036 /* Grrr... ¡Mi encantamiento! */
SAY REACT_TO_DIE_GENERAL @600037 /* Tu muerte no será en vano. */
SAY PICKED_POCKET @600040 /* I'm not proud of it, but I got away with it. */
SAY HIDDEN_IN_SHADOWS @600040 /* Like a shadow, I disappear. */
SAY SET_A_TRAP @600040 /* Ha! Let's see them try and get past that now. */
SAY BIO @600038 /* Cuando preguntas por su pasado, CHO'NUJA narra con orgullo de su procedencia en Dreach-naga, una de las capas del Abismo. Se crio en los Pantanos de Rask'tar Krathiss, la hydra campeona de la Reina Tisiphone. Durante décadas entrenó a los ejércitos de Dreach-naga y sirvió a su Reina, hasta que ésta le traicionó e intentó ejecutar cuando derrotaste a sus comandantes. Ahora, con el Abismo moribundo debido a la invasión de Morgrath, Cho intenta ajustarse a la vida de la superficie en el Plano Material. Si bien es un hombre-lagarto, no es un hombre-lagarto ordinario. Ha aprendido el Lenguaje Común e incluso enseñado el mismo a muchos de sus capitanes. Se interesa mucho por la vida de la gente en Faerûn, lo cual es extraño. Pretende acompañarte como un fiel guerrero y luchar a tu lado hasta las últimas consecuencias.  */
WRITE_ASCII 0x248 ~P_ChonS~ #8  // OVERRIDE SCRIPT - Scripts acerca de los comandos, banthers, etc (coincide con el nombre del archivo BAF)
WRITE_ASCII 0x2cc ~P_Chon~  #8  // DIALOGUE FILE - Archivo de saludo de Fall
WRITE_ASCII 0x280 ~P_Chon~  #32 // DEATH VARIABLE - Hace referencia a c?mo nos referimos a Fall en el juego. (Ej.: In Party (P_Fall))
WRITE_ASCII 0x34  ~P_CHO~ #8  // small portrait
WRITE_ASCII 0x3c  ~P_CHO~ #8  // medium portrait
WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~P_WGUA~))
    WRITE_LONG 0x28 (IDS_OF_SYMBOL (~animate~ ~P_REPTILE~))
//WRITE_SHORT 0x272 @200333

COPY ~Autumns_Twilight/Characters/cre_and_portraits/P_Alen.cre~ ~override/P_Alen.cre~ 

SAY NAME1 @200018 /* Alendir */
SAY NAME2 @200018 /* Alendir */
SAY INITIAL_MEETING @700000 /* ¿He vuelto... a la vida? */ 
